# Cloudflare test image only. Do not deploy until the D1 composition root is enabled.
FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/zaiko ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/zaiko /zaiko
ENV ZAIKO_ADDRESS=0.0.0.0:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/zaiko"]
